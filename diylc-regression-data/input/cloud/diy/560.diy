    <diylc.misc.Label>
      <name>LAB1</name>
      <point x="5.5" y="5.2"/>
      <text>Adjust 250k trimmer for best effect - symmetrical phasing!  I use the white noise from an FM radio tuned between stations for testing.</text>
      <font name="Dialog.bold" size="16" style="1"/>
      <color hex="000000"/>
      <horizontalAlignment>CENTER</horizontalAlignment>
      <verticalAlignment>CENTER</verticalAlignment>
      <orientation>DEFAULT</orientation>
    </diylc.misc.Label>
    <diylc.misc.Label>
      <name>LAB2</name>
      <point x="5.4" y="5.4"/>
      <text>500kΩ anti-log potentiometer sets phasing speed from around 3 seconds sweep time up  to &quot;Leslie&quot; effect speeds.&lt;br&gt;50kΩ lin potentiometer adjusts phasing depth by adjusting feedback.  If it &quot;howls&quot; at max FB, increase 10kΩ resistor *</text>
      <font name="Dialog.bold" size="16" style="1"/>
      <color hex="000000"/>
      <horizontalAlignment>CENTER</horizontalAlignment>
      <verticalAlignment>CENTER</verticalAlignment>
      <orientation>DEFAULT</orientation>
    </diylc.misc.Label>
    <diylc.misc.Label>
      <name>LAB3</name>
